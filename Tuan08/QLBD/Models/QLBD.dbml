<?xml version='1.0' encoding='utf-8'?>
<Database xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007" Name="QLBD" Class="QLBDDataContext">
  <Table Name="dbo.BD" Member="BangDiaRows">
