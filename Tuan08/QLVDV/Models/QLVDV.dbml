<?xml version='1.0' encoding='utf-8'?>
<Database xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007" Name="QLVDV" Class="QLVDVDataContext">
  <Table Name="dbo.tblThanhvien" Member="ThanhVienRows">
