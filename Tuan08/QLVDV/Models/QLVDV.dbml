      <Column Name="Sothich" Member="Sothich" Type="System.String" DbType="nvarchar(100)" CanBeNull="true"/>
      <Column Name="Diachi" Member="Diachi" Type="System.String" DbType="nvarchar(150) NOT NULL" CanBeNull="false"/>
      <Column Name="Dienthoai" Member="Dienthoai" Type="System.String" DbType="nvarchar(20) NOT NULL" CanBeNull="false"/>
      <Column Name="Quyenhan" Member="Quyenhan" Type="System.String" DbType="nvarchar(50) NOT NULL" CanBeNull="false"/>
      <Association Name="FK_tblPhieu_Mathanhvien" Member="PhieuByMathanhvien" ThisKey="MaThanhvien" OtherKey="Mathanhvien" Type="Phieu"/>
